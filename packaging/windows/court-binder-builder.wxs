<?xml version="1.0" encoding="utf-8"?>
<!-- Package definition for Court binder builder (WiX v5). Structure adapted from the PdfCraft
     packaging (https://github.com/richfrem/pdfcraft, packaging/windows/pdfcraft.wxs), dual-licensed
     MIT OR Apache-2.0: a dual-scope per-user / per-machine package with plain shortcuts and the
     scope rules in install-policy.wxi. The PDF file associations, context menus and OCR models of
     that package are not needed here. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Court binder builder" Manufacturer="bc-court-binder-builder project" Version="$(var.Version)" UpgradeCode="96FC72AE-B00C-45EA-AAB5-D197B6123596" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="Build and check BC court electronic binders" Manufacturer="bc-court-binder-builder project" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Court binder builder is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Windows Installer requires an Icon id ending in .ico or .exe, or shortcuts and Add/Remove
         Programs show a blank icon. The app's own executable supplies it. -->
    <Icon Id="CourtBinderBuilder.exe" SourceFile="$(var.AppDir)\Court binder builder.exe" />
    <Property Id="ARPPRODUCTICON" Value="CourtBinderBuilder.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/bcgov/bc-court-binder-builder" />
    <Property Id="ARPHELPLINK" Value="https://github.com/bcgov/bc-court-binder-builder/issues" />

    <!-- Desktop shortcut: on by default for a first install, a checkbox in the full-UI welcome
         dialog, and INSTALLDESKTOPSHORTCUT=0 on the msiexec command line for unattended installs.
         Secure, so the choice made in the (unelevated) UI reaches the elevated install. An update
         keeps the shortcut only if it is still on the desktop, so deleting it once keeps it away.
         A value given on the command line wins. -->
    <Property Id="INSTALLDESKTOPSHORTCUT" Secure="yes" />
    <!-- AppSearch runs before the full-UI scope page can choose Everyone, so [DesktopFolder] still
         names the user's desktop then. Search both desktops and keep the one for the chosen scope. -->
    <Property Id="EXISTINGDESKTOPSHORTCUT_USER">
      <DirectorySearch Id="DesktopSearchUser" Path="[DesktopFolder]" Depth="0">
        <FileSearch Name="Court binder builder.lnk" />
      </DirectorySearch>
    </Property>
    <Property Id="EXISTINGDESKTOPSHORTCUT_MACHINE">
      <DirectorySearch Id="DesktopSearchMachine" Path="[%PUBLIC]\Desktop" Depth="0">
        <FileSearch Name="Court binder builder.lnk" />
      </DirectorySearch>
    </Property>
    <SetProperty Id="EXISTINGDESKTOPSHORTCUT" Action="CbbExistingMachineShortcut" Value="[EXISTINGDESKTOPSHORTCUT_MACHINE]" After="CbbMFromLegacyExe" Sequence="first" Condition="ALLUSERS = 1 AND EXISTINGDESKTOPSHORTCUT_MACHINE" />
    <SetProperty Id="EXISTINGDESKTOPSHORTCUT" Action="CbbExistingUserShortcut" Value="[EXISTINGDESKTOPSHORTCUT_USER]" After="CbbExistingMachineShortcut" Sequence="first" Condition="ALLUSERS &lt;&gt; 1 AND EXISTINGDESKTOPSHORTCUT_USER" />
    <SetProperty Id="INSTALLDESKTOPSHORTCUT" Value="1" After="CbbExistingUserShortcut" Sequence="first" Condition="NOT INSTALLDESKTOPSHORTCUT AND (NOT WIX_UPGRADE_DETECTED OR EXISTINGDESKTOPSHORTCUT)" />
    <UIRef Id="CbbInstallerUI" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Court binder builder" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="Court binder builder" Level="1">
      <ComponentGroupRef Id="CbbFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="CbbFiles" Directory="INSTALLFOLDER">
      <Component Id="CbbApp" Guid="397286F4-98B5-4C17-860F-DBBEAEA55613">
        <File Id="CbbExe" Source="$(var.AppDir)\Court binder builder.exe" KeyPath="yes" />
        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\Court binder builder.exe" Value="[#CbbExe]" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\CourtBinderBuilder" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <!-- Shortcuts are plain links to the exe, not advertised MSI shortcuts (as in the PdfCraft
           package). Each has its own component with a registry key path, so Windows Installer
           removes it on uninstall; in a per-machine install both folders are the all-users ones. -->
      <Component Id="CbbStartMenuShortcut" Directory="ProgramMenuFolder" Guid="A4AE0EDA-71E2-4716-9658-43B219665365">
        <Shortcut Id="StartMenuShortcut" Name="Court binder builder" Description="Build and check BC court electronic binders" Target="[#CbbExe]" WorkingDirectory="INSTALLFOLDER" Icon="CourtBinderBuilder.exe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\CourtBinderBuilder\Shortcuts" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="CbbDesktopShortcut" Directory="DesktopFolder" Guid="912CAA51-F337-49C5-A6BE-1159BD67AC92" Condition="INSTALLDESKTOPSHORTCUT = 1">
        <Shortcut Id="DesktopShortcut" Name="Court binder builder" Description="Build and check BC court electronic binders" Target="[#CbbExe]" WorkingDirectory="INSTALLFOLDER" Icon="CourtBinderBuilder.exe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\CourtBinderBuilder\Shortcuts" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- Everything else the PyInstaller build produced (libraries, the UI, the skill scripts),
           one component per file, with its folder structure. New files ship without being named. -->
      <Files Include="$(var.AppDir)\**">
        <Exclude Files="$(var.AppDir)\Court binder builder.exe" />
      </Files>
    </ComponentGroup>
  </Fragment>
</Wix>
